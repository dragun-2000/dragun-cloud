<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProfile name="default">
        <property name="logPathFile" value="/var/log/spring"/>
    </springProfile>

    <springProfile name="development">
        <property name="logPathFile" value="/var/log/spring"/>
    </springProfile>

    <springProfile name="staging">debase
        <property name="logPathFile" value="/var/log/spring"/>
    </springProfile>

    <springProfile name="production">
        <property name="logPathFile" value="/var/log/spring"/>
    </springProfile>

    <appender name="Console" class="ch.qos.logback.core.ConsoleAppender">
        <layout class="ch.qos.logback.classic.PatternLayout">
            <Pattern>
                %d{ISO8601} %highlight(%-5level) [%blue(%t)] %yellow(%C{1.}): %msg%n%throwable
            </Pattern>
        </layout>
    </appender>

    <appender name="RollingFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${logPathFile}/${logFileName}.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <charset>UTF-8</charset>
            <Pattern>%d %p %C{1.} [%t] %m%n</Pattern>
        </encoder>

<!--        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">-->
<!--            &lt;!&ndash; daily rollover Once any of the below condition met, it will change the file name as below and compressed it. &ndash;&gt;-->
<!--            <fileNamePattern>${logPathFile}/archived/${logFileName}_%d{yyyy-MM-dd}.%i.log.zip</fileNamePattern>-->
<!--            &lt;!&ndash; keep 30 days' worth of history &ndash;&gt;-->
<!--            <maxHistory>30</maxHistory>-->
<!--            &lt;!&ndash; or whenever the file size reaches 2048MB &ndash;&gt;-->
<!--            <timeBasedFileNamingAndTriggeringPolicy-->
<!--                    class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">-->
<!--                <maxFileSize>2048MB</maxFileSize>-->
<!--            </timeBasedFileNamingAndTriggeringPolicy>-->
<!--        </rollingPolicy>-->
    </appender>

    <!-- LOG everything -->
    <root level="ERROR">
        <springProfile name="default">
            <appender-ref ref="Console"/>
        </springProfile>
        <appender-ref ref="RollingFile"/>
    </root>
    <root level="ERROR">
        <springProfile name="development">
            <appender-ref ref="Console"/>
        </springProfile>
        <appender-ref ref="RollingFile"/>
    </root>
    <root level="ERROR">
        <springProfile name="staging">
            <appender-ref ref="Console"/>
        </springProfile>
        <appender-ref ref="RollingFile"/>
    </root>
    <root level="ERROR">
        <springProfile name="production">
            <appender-ref ref="Console"/>
        </springProfile>
        <appender-ref ref="RollingFile"/>
    </root>

</configuration>